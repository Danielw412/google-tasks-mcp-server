# Google Tasks MCP server settings. Copied to ~/.config/google-tasks-mcp/server.env (chmod 600)
# by scripts/setup-services.sh. Read by the systemd service and by every google-tasks-mcp command.
# Every line is optional; the defaults are shown commented out.

# Bind address. Must be loopback; anything else is refused.
#GTASKS_HOST=127.0.0.1
#GTASKS_PORT=8765

# Google OAuth client. Default: the JSON downloaded from Google Cloud, saved as
# ~/.config/google-tasks-mcp/client_secret.json (chmod 600). Alternatively set both of these:
#GTASKS_GOOGLE_CLIENT_FILE=/path/to/client_secret.json
#GTASKS_GOOGLE_CLIENT_ID=
#GTASKS_GOOGLE_CLIENT_SECRET=

# Fallback authorization: another app's google-auth token.json, only read, and only used while this
# server's own Google authorization is missing or expired (and only for the same Google account).
#GTASKS_FALLBACK_TOKEN_FILE=~/projects/Canvas-Task-Sync/token.json
#GTASKS_FALLBACK_NAME=Canvas Task Sync

# Base URL a browser uses to reach this server's /oauth/google/callback. The default
# http://127.0.0.1:8765 works in a browser on this machine or through an SSH tunnel. Only set an
# https URL if you publish *only* /oauth/google/callback (never /mcp) through a reverse proxy, and
# then use a "Web application" OAuth client with <URL>/oauth/google/callback as a redirect URI.
#GTASKS_PUBLIC_BASE_URL=https://myserver.example.ts.net

# Timezone for "today", "tomorrow", and so on (default: America/New_York).
#GTASKS_TIMEZONE=America/New_York

# Optional editable Markdown task guide. Without this override, the server reads the bundled
# src/google_tasks_mcp/task_creation.md until the first approved MCP edit saves
# <state directory>/task_creation.md. Edits apply without a restart. An explicitly configured
# file must exist. With systemd, keep this file in the writable state directory.
#GTASKS_TASK_INSTRUCTIONS_FILE=~/.local/state/google-tasks-mcp/task_creation.md

#GTASKS_LOG_LEVEL=INFO
# Where Google credentials are stored. The systemd unit can only write the default location.
#GTASKS_STATE_DIR=~/.local/state/google-tasks-mcp

# Used by `google-tasks-mcp doctor` to check the tunnel.
#GTASKS_TUNNEL_PROFILE=google-tasks-test
#GTASKS_TUNNEL_CLIENT=/usr/local/bin/tunnel-client
